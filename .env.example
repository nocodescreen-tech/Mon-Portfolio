# ─────────────────────────────────────────────────────────────
# Variables d'environnement pour les fonctions serverless (api/)
# À configurer DANS VERCEL (Settings → Environment Variables).
# Avec le .env local (gitignoré), exécuter : set -a && . ./.env && set +a
# ─────────────────────────────────────────────────────────────

# ── Persistance des messages (Supabase Postgres) ──
# Connexion string (format pooler eu-west-1 fiable, IPv4) :
DATABASE_URL=postgresql://postgres.PROJECT_REF:VOTRE_MDP@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Authentification admin (secret JWT — CHANGEZ-LE) ──
JWT_SECRET=

# ── Origine autorisée (domaine du site, pour le cookie httpOnly en cross-origin) ──
SITE_ORIGIN=

# ── Email sortant (envoi vers votre boîte) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=