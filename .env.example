# ─────────────────────────────────────────────────────────────
# Variables d'environnement pour l'API de contact (api/contact.js)
# À configurer DANS VERCEL (Settings → Environment Variables),
# JAMAIS dans ce fichier ni dans le code. Ne pas committer de vraies clés.
# ─────────────────────────────────────────────────────────────

# Hôte SMTP de votre messagerie
#   Gmail : smtp.gmail.com
#   Zoho  : smtp.zoho.com
#   Outlook : smtp.office365.com
SMTP_HOST=

# Port SMTP (587 = STARTTLS, 465 = SSL)
SMTP_PORT=587

# Votre adresse d'envoi complète
SMTP_USER=

# Mot de passe applicatif (Gmail : compte Google → Sécurité → Mots de passe
# des applications — PAS votre mot de passe habituel)
SMTP_PASS=

# Expéditeur affiché (optionnel, défaut = SMTP_USER)
SMTP_FROM=

# Votre boîte de réception qui reçoit les messages du formulaire
CONTACT_TO=
